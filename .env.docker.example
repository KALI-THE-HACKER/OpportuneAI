# ==============================================================================
# OPPORTUNEAI DOCKER COMPOSE CONFIGURATION
# ==============================================================================

# Port exposed on the host machine by Nginx
PORT=80

# Frontend Public Variables (injected into client build)
# Leave VITE_API_URL empty or unset when using the unified Nginx reverse proxy
VITE_API_URL=
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-auth0-client-id
VITE_AUTH0_AUDIENCE=https://your-tenant.us.auth0.com/api/v2/
VITE_USE_SSL=false

# Note: Backend environment variables are read from backend/.env (or mapped in compose)
